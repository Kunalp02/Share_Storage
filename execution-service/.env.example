HOST=0.0.0.0
PORT=8765
LOG_LEVEL=info
LOG_FORMAT=text
CORS_ORIGINS=http://localhost:3000

AGENT_CONFIG_BASE_URL=http://127.0.0.1:8504
TOOLS_CONFIG_BASE_URL=http://127.0.0.1:8502
RAG_CONFIG_BASE_URL=http://127.0.0.1:8503
RAG_ASK_BASE_URL=http://127.0.0.1:8000

AUTH_SERVICE_BASE_URL=http://127.0.0.1:8500
AUTH_SERVICE_USERNAME=
AUTH_SERVICE_PASSWORD=

BIFROST_GATEWAY_BASE_URL=
BIFROST_GATEWAY_API_KEY=
LLM_GATEWAY_MOCK=false
LLM_CHAT_COMPLETIONS_PATH=/v1/chat/completions
LLM_GATEWAY_TIMEOUT_SECONDS=120
VERIFY_SSL=true

MANIFEST_CACHE_TTL_SECONDS=120
MODEL_CACHE_TTL_SECONDS=300
MEMORY_CACHE_TTL_SECONDS=30
SKIP_MODEL_REGISTRY_LOOKUP=true
USE_RUNTIME_MANIFEST_ENDPOINT=true
PERSIST_CONVERSATION_MEMORY=true
CONVERSATION_MAX_TURN_PAIRS=10
CONVERSATION_MAX_CHARS=8000
MAX_TOOL_ROUNDS=5

EXECUTION_DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/execution
CONVERSATION_STORE_DATABASE_URL=

STORAGE_SERVICE_BASE_URL=http://127.0.0.1:8770
STORAGE_INTERNAL_API_KEY=

TEST_THREAD_TTL_HOURS=24
DEFAULT_PRODUCTION_RETENTION_POLICY=PERMANENT
CLEANUP_INTERVAL_SECONDS=300

MAX_INFLIGHT_RUNS=8
RUN_SLOT_WAIT_SECONDS=2
RUN_LEASE_SECONDS=180
RUN_MAX_ATTEMPTS=3
WORKER_POLL_SECONDS=1
ARTIFACT_PROMPT_MAX_CHARS=12000
PERSIST_OUTPUT_ARTIFACTS=true
